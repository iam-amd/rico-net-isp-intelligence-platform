# Rico Net public demo environment
# Copy to .env for local development. Values below are demo-safe.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rico_net_demo
SECRET_KEY=change-this-demo-secret-before-any-public-backend
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO

# Local app origins. Add deployed Vercel/Netlify URLs when hosting.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Demo mode keeps hardware access disabled.
OLT_PROXY_ENABLED=false
OLT_PROXY_URL=
OLT_PROXY_TOKEN=
ALLOW_LEGACY_INGEST_TOKEN=false

RUN_CREATE_ALL_ON_STARTUP=false
RUN_STARTUP_SCHEMA_REPAIR=false
RUN_STARTUP_DATA_MAINTENANCE=true

