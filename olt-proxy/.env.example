# Raspberry Pi OLT collector environment
# Copy to .env on the Pi and fill real values. Do not commit the real .env.

# Backend reachable from the Pi, usually the office PC Tailscale URL.
BACKEND_URL=http://100.x.x.x:8000

# Must match this collector's backend collector_credentials row.
COLLECTOR_ID=pi-main-olt-room
OLT_PROXY_TOKEN=replace-with-collector-token-from-private-inventory

# On-demand OLT proxy API token. Separate from collector ingest token.
PROXY_TOKEN=replace-with-long-random-proxy-token

# Comma-separated OLT IPs reachable from this Pi.
OLT_HOSTS=10.10.10.100,10.10.10.200,10.10.10.210

# Normal monitoring is SNMP-only. Enable Telnet fallback only for an approved
# recovery window because it logs into real customer OLT hardware.
OLT_PRIMARY_TRANSPORT=snmp
OLT_FALLBACK_TRANSPORT=none

# OLT Telnet credentials from the private inventory/password vault.
# Required only when OLT_PRIMARY_TRANSPORT or OLT_FALLBACK_TRANSPORT uses telnet/web.
OLT_TELNET_USER=replace-with-olt-user
OLT_TELNET_PASSWORD=replace-with-olt-password

# Collector identity shown in NOC System Health.
COLLECTOR_NAME=Main OLT Room Pi
COLLECTOR_TAILSCALE_IP=100.x.x.x
COLLECTOR_VERSION=olt-poller-2026.04

# Polling and local buffering.
POLL_INTERVAL=60
SNAPSHOT_BUFFER_DB=/home/pi/rico-net/snapshot_buffer.db
LOG_LEVEL=INFO
